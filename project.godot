; Engine configuration file.
; Medieval Hide & Seek — Godot 4 V1 Prototype

config_version=5

[application]

config/name="Medieval Hide & Seek"
config/description="Jeu multijoueur medieval de cache-cache — prototype V1"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

NetworkManager="*res://autoload/network_manager.gd"
GameManager="*res://autoload/game_manager.gd"
QualityManager="*res://autoload/quality_manager.gd"
WorldMemory="*res://scripts/world/world_memory.gd"
TouchControls="*res://autoload/touch_controls.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

