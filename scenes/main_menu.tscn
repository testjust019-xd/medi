[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/main_menu.gd" id="1_menu"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_menu")

[node name="BG" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.08, 0.08, 0.09, 1)

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -200
offset_top = -180
offset_right = 200
offset_bottom = 180
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
text = "Medieval Hide & Seek"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 32

[node name="Sub" type="Label" parent="VBox"]
layout_mode = 2
text = "Prototype V1 — Godot 4"
horizontal_alignment = 1
theme_override_colors/font_color = Color(0.6, 0.6, 0.65, 1)
theme_override_font_sizes/font_size = 14

[node name="NameLabel" type="Label" parent="VBox"]
layout_mode = 2
text = "Votre nom:"

[node name="NameEdit" type="LineEdit" parent="VBox"]
layout_mode = 2
text = "Player"
placeholder_text = "Entrez votre nom"

[node name="HostBtn" type="Button" parent="VBox"]
layout_mode = 2
text = "Heberger une partie"
theme_override_font_sizes/font_size = 16

[node name="JoinBox" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="CodeEdit" type="LineEdit" parent="VBox/JoinBox"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Code d'invitation ou IP"

[node name="JoinBtn" type="Button" parent="VBox/JoinBox"]
layout_mode = 2
text = "Rejoindre"

[node name="Hint" type="Label" parent="VBox"]
layout_mode = 2
text = "Astuce: heberger sur un PC, partager le code, rejoindre depuis un autre."
theme_override_colors/font_color = Color(0.5, 0.5, 0.55, 1)
theme_override_font_sizes/font_size = 11

[connection signal="pressed" from="VBox/HostBtn" to="." method="_on_host_pressed"]
[connection signal="pressed" from="VBox/JoinBox/JoinBtn" to="." method="_on_join_pressed"]
