[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/hud.gd" id="1_hud"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Margin" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TimerLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "3:00"
horizontal_alignment = 1
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 36

[node name="HPBar" type="ProgressBar" parent="Margin/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(200, 0)
max_value = 100.0
value = 100.0
show_percentage = false

[node name="StaminaBar" type="ProgressBar" parent="Margin/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(200, 0)
max_value = 100.0
value = 100.0
show_percentage = false

[node name="CaptureLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Capture..."
horizontal_alignment = 1
theme_override_colors/font_color = Color(0.9, 0.7, 0.2, 1)

[node name="CaptureBar" type="ProgressBar" parent="Margin/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(300, 0)
max_value = 100.0
value = 0.0
show_percentage = false

[node name="ControlsLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Controls..."
theme_override_colors/font_color = Color(0.5, 0.5, 0.55, 0.8)
theme_override_font_sizes/font_size = 11

[node name="ResultPanel" type="Panel" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -200
offset_top = -60
offset_right = 200
offset_bottom = 60

[node name="ResultLabel" type="Label" parent="ResultPanel"]
